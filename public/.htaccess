<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si la peticion es un archivo o directorio real, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Si la URL ya tiene locale explicito, dejar pasar
  RewriteRule ^(es|en)(/|$) - [L]

  # Redirigir todo lo demas al locale por defecto (en)
  RewriteRule ^(.*)$ en/$1 [L]
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# Compresion gzip para assets estaticos
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache para assets estaticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
